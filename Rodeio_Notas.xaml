<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1920" Height="1080">
    <Grid>
        <Canvas>
            <!-- FUNDO PRETO -->
            <Rectangle Canvas.Left="500" Canvas.Top="800" Width="900" Height="150" Fill="Black" Stroke="Gold" StrokeThickness="2" Opacity="0.9" />
            
            <!-- CAMPOS VMIX (DEVEM USAR Name="Campo") -->
            <TextBlock Name="Competidor" Text="COMPETIDOR" Canvas.Left="520" Canvas.Top="820" FontSize="48" Foreground="White" Width="600" />
            <TextBlock Name="Animal" Text="ANIMAL" Canvas.Left="520" Canvas.Top="890" FontSize="24" Foreground="LightGray" Width="600" />
            
            <TextBlock Name="J1" Text="0" Canvas.Left="1150" Canvas.Top="820" FontSize="32" Foreground="White" Width="60" TextAlignment="Center" />
            <TextBlock Name="J2" Text="0" Canvas.Left="1150" Canvas.Top="870" FontSize="32" Foreground="White" Width="60" TextAlignment="Center" />
            <TextBlock Name="J3" Text="0" Canvas.Left="1220" Canvas.Top="820" FontSize="32" Foreground="White" Width="60" TextAlignment="Center" />
            <TextBlock Name="J4" Text="0" Canvas.Left="1220" Canvas.Top="870" FontSize="32" Foreground="White" Width="60" TextAlignment="Center" />
            
            <!-- TOTAL -->
            <Rectangle Canvas.Left="1300" Canvas.Top="800" Width="100" Height="150" Fill="Gold" />
            <TextBlock Name="Total" Text="0" Canvas.Left="1300" Canvas.Top="840" FontSize="60" Foreground="Black" FontWeight="Bold" Width="100" TextAlignment="Center" />
        </Canvas>
    </Grid>
</UserControl>
